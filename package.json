{
  "name": "@tssuite/supply-chain-app",
  "version": "0.0.1",
  "description": "Browser demo for @tssuite/supply-chain: visualizes a supply chain with Mermaid",
  "homepage": "https://github.com/tssuite/supply-chain-app",
  "bugs": "https://github.com/tssuite/supply-chain-app/issues",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tssuite/supply-chain-app.git"
  },
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "tsc && npx vite build",
    "prebuild": "pnpm run test",
    "preview": "npx vite preview",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:snapshots",
    "test:unit": "npx vitest run --coverage && pnpm run lint",
    "test:e2e": "npx playwright test",
    "test:snapshots": "npx playwright test --update-snapshots",
    "lint": "npx prettier --write . && npx eslint --fix"
  },
  "dependencies": {
    "@tssuite/supply-chain": "^0.1.0",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-dom": "^0.1.1"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
